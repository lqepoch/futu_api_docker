# Required login inputs. The installer stores the password as base64 in its root-only env file.
FUTU_LOGIN_ACCOUNT=
FUTU_LOGIN_PASSWORD=
FUTU_LOGIN_PASSWORD_B64=
FUTU_LOGIN_PASSWORD_FILE=
# Phone-number accounts may need a country code, e.g. +86.
FUTU_AREA_CODE=

# Automatic interactive login behavior.
FUTU_REMEMBER_PASSWORD=false
FUTU_AUTO_REQUEST_PHONE_CODE=true
FUTU_PHONE_CODE_REQUEST_DELAY_SECONDS=8

# Futu API TCP listener inside the container.
FUTU_API_IP=0.0.0.0
FUTU_API_PORT=11111
# Used by install.sh / Compose for host publishing.
FUTU_API_PUBLISH_ADDRESS=127.0.0.1

# Optional API protocol RSA override.
# If all are empty, the container generates a persistent PKCS#1 RSA key automatically.
FUTU_API_RSA_PRIVATE_KEY_B64=
FUTU_API_RSA_PRIVATE_KEY_FILE=

# Internal OpenD operation channel. It is not published by the default deployment.
FUTU_TELNET_IP=127.0.0.1
FUTU_TELNET_PORT=22222

# WebSocket / WSS.
FUTU_WEBSOCKET_ENABLED=true
FUTU_WEBSOCKET_IP=0.0.0.0
FUTU_WEBSOCKET_PORT=33333
FUTU_WEBSOCKET_PUBLISH_ADDRESS=0.0.0.0

# WebSocket auth. If empty, a persistent random key is generated automatically.
FUTU_WEBSOCKET_AUTH_KEY=
FUTU_WEBSOCKET_AUTH_KEY_MD5=
FUTU_WEBSOCKET_AUTH_KEY_FILE=

# WSS certificate override.
# If all are empty, a persistent self-signed certificate is generated automatically.
# For Internet/browser use, provide a CA-signed cert/key via base64 or mounted files.
FUTU_WEBSOCKET_CERT_B64=
FUTU_WEBSOCKET_CERT_FILE=
FUTU_WEBSOCKET_PRIVATE_KEY_B64=
FUTU_WEBSOCKET_PRIVATE_KEY_FILE=
FUTU_WEBSOCKET_TLS_CN=futu-opend

# General OpenD options.
FUTU_LANG=en
FUTU_LOG_LEVEL=info
FUTU_PUSH_PROTO_TYPE=0
FUTU_QOT_PUSH_FREQUENCY=
FUTU_PRICE_REMINDER_PUSH=1
FUTU_AUTO_HOLD_QUOTE_RIGHT=1
FUTU_FUTURES_TZ=UTC+8
