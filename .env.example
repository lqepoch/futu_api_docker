# Published image
FUTU_IMAGE=ghcr.io/lqepoch/futu_api_docker:latest

# Detached startup after the first interactive login has successfully stored the remembered password.
FUTU_LOGIN_ACCOUNT=
# Only set this when the login account is a phone number and an explicit country code is needed.
FUTU_AREA_CODE=

# Futu API TCP service inside the container.
FUTU_API_IP=0.0.0.0
FUTU_API_PORT=11111
# Host publishing. Keep 127.0.0.1 if the trading bot is on the same server.
FUTU_API_BIND_ADDRESS=127.0.0.1
FUTU_API_HOST_PORT=11111

# OpenD protocol RSA private key (PKCS#1). Required for remote trading when API listen IP is non-local.
# Provide exactly one of *_B64 or *_FILE. *_FILE may point under /run/user-secrets.
FUTU_API_RSA_PRIVATE_KEY_B64=
FUTU_API_RSA_PRIVATE_KEY_FILE=/run/user-secrets/futu_api_rsa.pem
FUTU_REQUIRE_API_RSA=true

# Telnet is intentionally container-internal; use `docker exec ... futu-opend-cli ...`.
FUTU_TELNET_IP=127.0.0.1
FUTU_TELNET_PORT=22222

# WebSocket / WSS.
FUTU_WEBSOCKET_ENABLED=true
FUTU_WEBSOCKET_IP=0.0.0.0
FUTU_WEBSOCKET_PORT=33333
FUTU_WEBSOCKET_BIND_ADDRESS=0.0.0.0
FUTU_WEBSOCKET_HOST_PORT=33333
# Plaintext is hashed to MD5 inside the container. *_MD5 is also supported.
FUTU_WEBSOCKET_AUTH_KEY=
FUTU_WEBSOCKET_AUTH_KEY_FILE=
FUTU_WEBSOCKET_AUTH_KEY_MD5=
FUTU_WEBSOCKET_AUTH_KEY_MD5_FILE=
# When WebSocket listens on a non-local IP, OpenD requires TLS cert + unencrypted private key.
FUTU_WEBSOCKET_CERT_B64=
FUTU_WEBSOCKET_CERT_FILE=/run/user-secrets/websocket.crt
FUTU_WEBSOCKET_PRIVATE_KEY_B64=
FUTU_WEBSOCKET_PRIVATE_KEY_FILE=/run/user-secrets/websocket.key

# General OpenD options.
FUTU_LANG=chs
FUTU_LOG_LEVEL=info
FUTU_PUSH_PROTO_TYPE=0
FUTU_QOT_PUSH_FREQUENCY=
FUTU_PRICE_REMINDER_PUSH=1
FUTU_AUTO_HOLD_QUOTE_RIGHT=1
FUTU_FUTURES_TZ=UTC+8
