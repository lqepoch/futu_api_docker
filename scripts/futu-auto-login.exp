#!/usr/bin/expect -f

set timeout -1
match_max 16384

if {![info exists env(FUTU_LOGIN_ACCOUNT)] || $env(FUTU_LOGIN_ACCOUNT) eq ""} {
    puts stderr "ERROR: FUTU_LOGIN_ACCOUNT is required"
    exit 2
}
if {![info exists env(FUTU_LOGIN_PASSWORD_RESOLVED_FILE)]} {
    puts stderr "ERROR: resolved password file is missing"
    exit 2
}

set fp [open $env(FUTU_LOGIN_PASSWORD_RESOLVED_FILE) r]
fconfigure $fp -translation binary
set password [read $fp]
close $fp
set password [string trimright $password "\r\n"]

set account $env(FUTU_LOGIN_ACCOUNT)
set config $env(FUTU_CONFIG_FILE)
set lang "en"
if {[info exists env(FUTU_LANG)] && $env(FUTU_LANG) ne ""} {
    set lang $env(FUTU_LANG)
}

set remember 0
if {[info exists env(FUTU_REMEMBER_PASSWORD)]} {
    set v [string tolower $env(FUTU_REMEMBER_PASSWORD)]
    if {$v in {"1" "true" "yes" "y"}} {
        set remember 1
    }
}

set cmd [list /opt/futu-opend/FutuOpenD "-cfg_file=$config" "-login_account=$account" "-lang=$lang"]
if {[info exists env(FUTU_AREA_CODE)] && $env(FUTU_AREA_CODE) ne ""} {
    lappend cmd "-area_code=$env(FUTU_AREA_CODE)"
}

puts stderr "Starting Futu OpenD with automated account/password input."
spawn -noecho {*}$cmd

set sent_account 0
set sent_password 0
set sent_remember 0

expect {
    -re {(?i)(login account|account|账号|帳號).*[：:]\s*$} {
        if {!$sent_account} {
            send -- "$account\r"
            set sent_account 1
        }
        exp_continue
    }
    -re {(?i)(login password|password|密码|密碼).*[：:]\s*$} {
        if {!$sent_password} {
            send -- "$password\r"
            set sent_password 1
        }
        exp_continue
    }
    -re {(?i)(remember.*password|remember me|记住密码|記住密碼).*([01].*[01]|0/1|1/0)} {
        if {!$sent_remember} {
            if {$remember} { send -- "1\r" } else { send -- "0\r" }
            set sent_remember 1
        }
        exp_continue
    }
    -re {(?i)(remember.*password|remember me|记住密码|記住密碼)} {
        if {!$sent_remember} {
            if {$remember} { send -- "y\r" } else { send -- "n\r" }
            set sent_remember 1
        }
        exp_continue
    }
    eof {
        catch wait result
        if {[llength $result] >= 4} {
            exit [lindex $result 3]
        }
        exit 1
    }
}
