#!/usr/bin/expect -f

# Keep account and password input in OpenD's own terminal. When OpenD emits
# its phone-code operation prompt, collect only the one-time code from the
# same terminal and forward the operation command to OpenD's local Telnet
# port. The code is never written to a file, environment variable, or log.
set timeout -1
log_user 1

proc restore_user_terminal {} {
    if {[catch {exec sh -c {test -t 0}}] == 0} {
        catch {stty echo}
    }
}

proc read_phone_code {} {
    while {1} {
        send_user "\n\[futu-docker\] 请输入手机验证码: "
        stty -echo
        expect_user {
            -re {([0-9]{4,8})[\r\n]} {
                set code $expect_out(1,string)
                stty echo
                send_user "\n"
                return $code
            }
            -re {[^\r\n]*[\r\n]} {
                stty echo
                send_user "\n\[futu-docker\] 验证码应为 4-8 位数字，请重新输入。"
            }
            eof {
                stty echo
                exit 1
            }
        }
    }
}

proc submit_phone_code {code host port} {
    if {[catch {
        set telnet_channel [socket $host $port]
        fconfigure $telnet_channel -translation crlf -buffering line
        puts $telnet_channel "input_phone_verify_code -code=$code"
        flush $telnet_channel
        close $telnet_channel
    }]} {
        send_user "\n\[futu-docker\] 无法提交手机验证码到 OpenD 运维端口，请改用 Telnet 方式。\n"
        return 1
    }
    return 0
}

proc user_terminal_size {} {
    if {[catch {set output [string trim [exec stty size]]}]} {
        return {}
    }
    if {![regexp {^([0-9]+)[[:space:]]+([0-9]+)$} $output -> rows columns]
        || $rows <= 0 || $columns <= 0} {
        return {}
    }
    return [list $rows $columns]
}

proc wait_for_attached_terminal {} {
    # A detached `docker run -d -it` still gives Expect a pty, but Docker
    # reports a 0x0 window until the first `docker attach` supplies its size.
    # Wait before starting OpenD so this prompt is visible in that attach
    # session instead of being emitted into an unseen pty buffer.
    if {[catch {fconfigure stdin -mode}]} {
        return
    }
    while {1} {
        if {[llength [user_terminal_size]] == 2} {
            return
        }
        after 250
    }
}

proc copy_user_terminal_size_to_child {child_tty} {
    # Expect allocates a fresh pty for OpenD. Without copying the attached
    # terminal dimensions, that pty reports 0x0 to OpenD; its native console
    # then consumes account/password input as empty lines. Write explicitly to
    # the spawned OpenD pty so foreground and attach-after-start both work.
    set size [user_terminal_size]
    if {[llength $size] != 2} {
        return 0
    }

    set rows [lindex $size 0]
    set columns [lindex $size 1]
    if {![string is integer -strict $rows] || ![string is integer -strict $columns] \
        || $rows <= 0 || $columns <= 0} {
        return 0
    }
    set stty_result [catch {stty rows $rows columns $columns < $child_tty}]
    if {$stty_result} {
        return 0
    }
    return 1
}

if {$argc == 0} {
    puts stderr "usage: futu-opend-direct-otp.expect command [args...]"
    exit 64
}

set telnet_host "127.0.0.1"
set telnet_port "22222"
catch {set telnet_host $env(FUTU_LOGIN_TELNET_HOST)}
catch {set telnet_port $env(FUTU_TELNET_PORT)}
trap {restore_user_terminal; exit 130} SIGINT
trap {restore_user_terminal; exit 143} SIGTERM

wait_for_attached_terminal
send_user "\n\[futu-docker\] 登录提示：请输入富途账号、手机号或邮箱（手机号默认 +86）。\n"
spawn -noecho {*}$argv
set child_tty $spawn_out(slave,name)
copy_user_terminal_size_to_child $child_tty
interact {
    -input $user_spawn_id -output $spawn_id
    -re {(.|\n)+} {
        # `docker run -d -it` has a 0x0 pty until `docker attach` supplies the
        # terminal size. Copy it on the first byte (and on later keystrokes so
        # terminal resizing also reaches OpenD), then forward the exact input.
        copy_user_terminal_size_to_child $child_tty
        send -raw -i $spawn_id $interact_out(0,string)
    }
    -input $spawn_id -output $user_spawn_id
    -re {input_phone_verify_code[[:space:]]+-code=[0-9]+} {
        send_user -raw $interact_out(0,string)
        set phone_code [read_phone_code]
        submit_phone_code $phone_code $telnet_host $telnet_port
    }
    eof {return}
}

restore_user_terminal
set wait_result [wait]
exit [lindex $wait_result 3]
