#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -eq 0 ]]; then
  cat >&2 <<'USAGE'
Usage: futu-opend-cli <OpenD operation command> [arguments]
Examples:
  futu-opend-cli req_phone_verify_code
  futu-opend-cli input_phone_verify_code -code=123456
  futu-opend-cli ping
USAGE
  exit 2
fi

host="${FUTU_TELNET_HOST:-127.0.0.1}"
port="${FUTU_TELNET_PORT:-22222}"
timeout="${FUTU_TELNET_TIMEOUT:-5}"
command="$*"

printf '%s\r\n' "$command" | nc -w "$timeout" "$host" "$port"
