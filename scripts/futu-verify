#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  futu-verify phone <code>
  futu-verify request-phone
  futu-verify pic <code>
  futu-verify request-pic
  futu-verify ping
  futu-verify show-api-key
  futu-verify show-ws-key
  futu-verify show-ws-cert
EOF
  exit 2
}

state="/home/futu/.com.futunn.FutuOpenD/docker-secrets"
cmd="${1:-}"

case "$cmd" in
  phone)
    code="${2:-}"
    [[ "$code" =~ ^[0-9]{4,8}$ ]] || usage
    exec futu-opend-cli input_phone_verify_code "-code=$code"
    ;;
  request-phone)
    exec futu-opend-cli req_phone_verify_code
    ;;
  pic)
    code="${2:-}"
    [[ "$code" =~ ^[0-9A-Za-z]{3,12}$ ]] || usage
    exec futu-opend-cli input_pic_verify_code "-code=$code"
    ;;
  request-pic)
    exec futu-opend-cli req_pic_verify_code
    ;;
  ping)
    exec futu-opend-cli ping
    ;;
  show-api-key)
    if [[ -n "${FUTU_API_RSA_PRIVATE_KEY_B64:-}" ]]; then
      printf '%s' "$FUTU_API_RSA_PRIVATE_KEY_B64" | base64 --decode
    elif [[ -n "${FUTU_API_RSA_PRIVATE_KEY_FILE:-}" && -r "$FUTU_API_RSA_PRIVATE_KEY_FILE" ]]; then
      cat "$FUTU_API_RSA_PRIVATE_KEY_FILE"
    else
      cat "$state/api-rsa.pem"
    fi
    ;;
  show-ws-key)
    if [[ -n "${FUTU_WEBSOCKET_AUTH_KEY:-}" ]]; then
      printf '%s\n' "$FUTU_WEBSOCKET_AUTH_KEY"
    elif [[ -n "${FUTU_WEBSOCKET_AUTH_KEY_FILE:-}" && -r "$FUTU_WEBSOCKET_AUTH_KEY_FILE" ]]; then
      cat "$FUTU_WEBSOCKET_AUTH_KEY_FILE"
    else
      cat "$state/websocket-auth-key"
    fi
    ;;
  show-ws-cert)
    if [[ -n "${FUTU_WEBSOCKET_CERT_B64:-}" ]]; then
      printf '%s' "$FUTU_WEBSOCKET_CERT_B64" | base64 --decode
    elif [[ -n "${FUTU_WEBSOCKET_CERT_FILE:-}" && -r "$FUTU_WEBSOCKET_CERT_FILE" ]]; then
      cat "$FUTU_WEBSOCKET_CERT_FILE"
    else
      cat "$state/websocket.crt"
    fi
    ;;
  *)
    usage
    ;;
esac
